{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.2/.schema/devbox.schema.json",
  "packages": [
    "nodejs@22"
  ],
  "shell": {
    "init_hook": [
      "npm install"
    ],
    "scripts": {
      "serve": "npm run serve",
      "watch": "npm run watch",
      "html": "npm run html",
      "pdf": "npm run pdf",
      "pptx": "npm run pptx"
    }
  }
}
